generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model livros {
  id                Int      @id @default(autoincrement())
  titulo            String
  autor_id          Int
  ano_de_publicacao DateTime
  editora           String
  genero            String
  numero_de_paginas Int

  criado_em     DateTime @default(now()) @db.Timestamptz(6)
  modificado_em DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  autores autores @relation(fields: [autor_id], references: [id])
}

model autores {
  id                 Int      @id @default(autoincrement())
  nome               String
  data_de_nascimento DateTime @db.Date

  criado_em     DateTime @default(now()) @db.Timestamptz(6)
  modificado_em DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  livros livros[]
}
